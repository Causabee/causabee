      }
    },
    "Your plan": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Plan"
          }
        }
      }
    },
    "Pro, now and then": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro, ab und zu"
          }
        }
      }
    },
    "Causabee holds %lld open matters for free. Close one — or make room for all of them. Nothing you have is ever locked.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Causabee hält %lld offene Anliegen gratis. Schließ eines ab — oder mach Platz für alle. Was du hast, wird nie weggeschlossen."
          }
        }
      }
    },
    "The bigger AI reads what comes in, as it comes, writes each matter's brief and answers about everything — names always disguised.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die größere KI liest, was hereinkommt, sobald es kommt, schreibt die Zusammenfassung jedes Anliegens und antwortet zu allem — Namen immer unkenntlich."
          }
        }
      }
    },
    "Free stays on your device. Plus for every matter, Pro for the bigger AI.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis bleibt auf deinem Gerät. Plus für jedes Anliegen, Pro für die größere KI."
          }
        }
      }
    },
    "A top-up lets Pro read again: %@": {
      "localizations": {
