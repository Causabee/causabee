          }
        }
      }
    },
    "In Mail, open a mail about something you’re dealing with — a move, a claim, a parent’s care.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne in Mail eine Mail zu etwas, das dich beschäftigt — ein Umzug, ein Schadensfall, die Pflege eines Elternteils."
          }
        }
      }
    },
    "Move it to the folder “%@”.": {
