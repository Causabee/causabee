          }
        }
      }
    },
    "The matter goes away from the list and from the assistant. Nothing is deleted, and “Open again” brings it back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Anliegen verschwindet aus der Liste und aus dem Assistenten. Nichts wird gelöscht, und „Wieder öffnen“ holt es zurück."
          }
        }
      }
    },
    "Writing the brief …": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammenfassung wird geschrieben …"
