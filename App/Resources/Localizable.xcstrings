      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Aufgabe"
          }
        }
      }
    },
    "none — just for the matter": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "keine — nur für das Anliegen"
          }
        }
      }
