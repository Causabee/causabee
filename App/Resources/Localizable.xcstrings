          "stringUnit": {
            "state": "translated",
            "value": "Gerade nichts für dich"
          }
        }
      }
    },
    "Causabee reads the facts of this matter with your notes, pseudonymised, and suggests a step with a reason.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Causabee liest die Fakten dieses Anliegens mit deinen Notizen, pseudonymisiert, und schlägt einen Schritt mit Begründung vor."
          }
        }
      }
    },
