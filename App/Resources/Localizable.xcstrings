    "Causabee Pro": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Causabee Pro"
          }
        }
      }
    },
    "Reads what comes in — mail, screenshots, photos, files, your notes — fills the cards, answers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest, was hereinkommt — Mail, Screenshots, Fotos, Dateien, deine Notizen —, füllt die Karten, antwortet."
          }
        }
      }
    },
    "Use Pro": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro nutzen"
          }
        }
      }
    },
    "This version of Causabee has no iCloud: your matters stay on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version von Causabee hat kein iCloud: deine Anliegen bleiben auf diesem Mac."
          }
        }
      }
    },
    "iCloud": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud"
          }
        }
      }
    },
    "In the demo, iCloud stays off: the made-up matters never meet your iCloud. Your choice counts again when you leave the demo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Beispiel bleibt iCloud aus: die erfundenen Anliegen treffen nie auf dein iCloud. Deine Wahl gilt wieder, sobald du das Beispiel verlässt."
          }
        }
      }
    },
    "Takes effect when Causabee starts again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirkt, wenn Causabee neu startet."
          }
        }
      }
    },
    "Quit Causabee": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Causabee beenden"
          }
        }
      }
    },
    "Your matters, tasks, dates, people, digests, the assistant's history, and the full texts of mails and scans — those end to end encrypted — sync through your private iCloud. Files go into the matters' folders.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Anliegen, Aufgaben, Termine, Personen, Überblicke, der Verlauf des Assistenten und die vollen Texte von Mails und Scans — diese Ende-zu-Ende-verschlüsselt — gleichen sich über dein privates iCloud ab. Dateien kommen in die Ordner der Anliegen."
          }
        }
      }
    },
