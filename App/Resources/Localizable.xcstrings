    "It could not be saved on this %@. Is there space left?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es konnte auf diesem %@ nicht gesichert werden. Ist noch Platz?"
          }
        }
      }
