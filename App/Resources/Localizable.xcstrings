    "Not important": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht wichtig"
          }
        }
      }
    },
    "It will not come back. Nothing is deleted: the link is in the mail.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er kommt nicht zurück. Nichts wird gelöscht: der Link steht in der Mail."
