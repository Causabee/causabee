    "Copy the code at Apple, then %@ Paste.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopier den Code bei Apple, dann %@ Einfügen."
          }
        }
      }
    },
    "Apple gives apps like Causabee their own password, so your Apple Account password is never shared.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple gibt Apps wie Causabee ein eigenes Passwort, damit das Passwort deines Apple-Accounts nie weitergegeben wird."
