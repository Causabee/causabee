        }
      }
    },
    "A contact you add stays in this matter. If something from them comes in later, it is the same contact.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kontakt, den du hinzufügst, bleibt in diesem Anliegen. Kommt später etwas von ihm, ist es derselbe Kontakt."
