    "Pull down to try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh nach unten, um es erneut zu versuchen."
          }
        }
      }
    },
    "Sorting it in …": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird einsortiert …"
          }
        }
      }
    },
    "Nothing to do or to note in it — it is kept with the matter, with its words.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts zu tun und nichts zu merken darin — es bleibt beim Anliegen, mit seinen Worten."
          }
        }
      }
    },
    "A new matter …": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neues Anliegen …"
          }
        }
      }
    },
    "Other": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anderes"
          }
        }
      }
    },
    "Make it": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anlegen"
          }
        }
