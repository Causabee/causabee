          "stringUnit": {
            "state": "translated",
            "value": " · nicht in Nutzung"
          }
        }
      }
    },
    "This month's Pro": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro in diesem Monat"
          }
        }
      }
    },
