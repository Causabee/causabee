{
  "sourceLanguage": "en",
  "strings": {
    "Causabee's shared folder on this %@ cannot be reached.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Causabees geteilter Ordner auf diesem %@ ist nicht erreichbar."
          }
        }
      }
    },
    "Causabee takes pictures and PDFs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Causabee nimmt Bilder und PDFs entgegen."
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen"
          }
        }
      }
    },
