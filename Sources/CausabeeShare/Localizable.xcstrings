    "Causabee sorts it in when it next opens, and says where it went.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Causabee sortiert es ein, wenn sie das nächste Mal geöffnet wird, und sagt, wohin es ging."
          }
        }
      }
    },
